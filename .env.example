# Since ".env*.local" files are gitignored, you can use this ".env.example"
# file to build a new ".env.local" file when you clone the repo. Keep this file
# up-to-date when you add new variables.

# This file will be committed to version control, so make sure not to have any
# secrets in it.

# Personal dev.to API key, used to list published articles on /blogs.
# Generate one at https://dev.to/settings/extensions
DEVTO_API_KEY=""

# Canonical site origin, used for `metadataBase` / Open Graph URLs.
# Falls back to https://mainak.vercel.app when unset.
NEXT_PUBLIC_APP_URL=""
